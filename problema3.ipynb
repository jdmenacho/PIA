   "source": [
    "#operaciones con conjuntos.\n",
    "\n",
    "listav1 ={1,2,3,4,5,6}\n",
    "listav2 = {10,11,1,3,6,7}\n",
    "diccion = {}\n",
    "\n",
    "diccion[\"interseccion\"] = listav1 & listav2\n",
    "diccion[\"union\"] = listav1 | listav2\n",
    "diccion[\"diferencia\"] = listav1 ^ listav2\n",
    "\n",
    "print(diccion)\n"
   ]
